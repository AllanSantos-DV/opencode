{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "everything": {
        "type": "local",
        "command": ["npx", "-y", "@modelcontextprotocol/server-everything"],
        "disabled": false,
      },
      "context7": {
        "type": "local",
        "command": ["npx", "-y", "@upstash/context7-mcp"],
        "disabled": false,
      },
      "posthog": {
        "type": "remote",
        "url": "https://mcp.posthog.com/mcp",
      },
      "figma": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp",
      },
    },
  },
}
